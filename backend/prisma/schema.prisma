datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DocumentStatus {
  QUEUED
  PROCESSING
  INDEXED
  FAILED
}

enum MessageSender {
  USER
  AGENT
  SYSTEM
  TOOL
}

enum WorkflowStatus {
  ACTIVE
  PAUSED
  DRAFT
}

// --------------------------------------------------------
// MULTI-TENANCY & IDENTITY
// --------------------------------------------------------

model Tenant {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  slug         String   @unique @db.VarChar(100)
  plan         String   @default("STARTER") @db.VarChar(50)
  settings     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  TenantMembership[]
  workspaces   Workspace[]
  projects     Project[]
  tasks        Task[]
  documents    Document[]
  agents       AiAgent[]
  workflows    AutomationWorkflow[]
  auditLogs    AuditLog[]

  @@index([slug])
  @@map("tenants")
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique @db.VarChar(255)
  passwordHash      String?  @db.VarChar(255)
  fullName          String   @db.VarChar(100)
  avatarUrl         String?  @db.VarChar(500)
  isEmailVerified   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberships       TenantMembership[]
  workspaceMembers  WorkspaceMember[]
  assignedTasks     TaskAssignee[]
  taskComments      TaskComment[]
  chatSessions      ChatSession[]
  auditLogs         AuditLog[]

  @@index([email])
  @@map("users")
}

model TenantMembership {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  userId    String     @db.Uuid
  role      TenantRole @default(MEMBER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, role])
  @@map("tenant_memberships")
}

// --------------------------------------------------------
// WORKSPACES & PROJECTS
// --------------------------------------------------------

model Workspace {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(100)
  description String?  @db.Text
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  projects    Project[]
  documents   Document[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  role        String    @default("MEMBER") @db.VarChar(50)
  joinedAt    DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  workspaceId String   @db.Uuid
  name        String   @db.VarChar(120)
  key         String   @db.VarChar(20)
  description String?  @db.Text
  status      String   @default("ACTIVE") @db.VarChar(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@unique([tenantId, key])
  @@index([tenantId, workspaceId])
  @@map("projects")
}

// --------------------------------------------------------
// TASKS & COLLABORATION
// --------------------------------------------------------

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  projectId      String       @db.Uuid
  parentTaskId   String?      @db.Uuid
  taskNumber     Int          @default(autoincrement())
  title          String       @db.VarChar(255)
  description    String?      @db.Text
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  orderIndex     Float        @default(0.0)
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask     Task?          @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks       Task[]         @relation("TaskHierarchy")
  assignees      TaskAssignee[]
  comments       TaskComment[]
  activities     TaskActivity[]

  @@index([tenantId, projectId, status])
  @@index([tenantId, dueDate])
  @@map("tasks")
}

model TaskAssignee {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @db.Uuid
  userId     String   @db.Uuid
  assignedAt DateTime @default(now())

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_assignees")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  userId    String   @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model TaskActivity {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  actorId   String   @db.Uuid
  action    String   @db.VarChar(100)
  changes   Json
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_activities")
}

// --------------------------------------------------------
// KNOWLEDGE BASE & RAG (PGVECTOR)
// --------------------------------------------------------

model Document {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  workspaceId String         @db.Uuid
  title       String         @db.VarChar(255)
  storageKey  String         @db.VarChar(500)
  mimeType    String         @db.VarChar(100)
  fileSize    Int
  status      DocumentStatus @default(QUEUED)
  errorMsg    String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks      DocumentChunk[]

  @@index([tenantId, workspaceId])
  @@map("documents")
}

model DocumentChunk {
  id          String                      @id @default(uuid()) @db.Uuid
  tenantId    String                      @db.Uuid
  documentId  String                      @db.Uuid
  chunkIndex  Int
  content     String                      @db.Text
  tokenCount  Int
  metadata    Json                        @default("{}")
  embedding   Unsupported("vector(768)")?
  createdAt   DateTime                    @default(now())

  document    Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@map("document_chunks")
}

// --------------------------------------------------------
// AI AGENTS & CONVERSATIONS
// --------------------------------------------------------

model AiAgent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  name          String   @db.VarChar(100)
  description   String?  @db.Text
  modelName     String   @default("gemini-1.5-pro") @db.VarChar(50)
  systemPrompt  String   @db.Text
  temperature   Float    @default(0.2)
  allowedTools  String[]
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chatSessions  ChatSession[]

  @@index([tenantId])
  @@map("ai_agents")
}

model ChatSession {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  userId    String        @db.Uuid
  agentId   String?       @db.Uuid
  title     String        @default("New Chat") @db.VarChar(200)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     AiAgent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  messages  ChatMessage[]

  @@index([tenantId, userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id         String        @id @default(uuid()) @db.Uuid
  sessionId  String        @db.Uuid
  senderType MessageSender
  content    String        @db.Text
  toolCalls  Json?
  tokenCount Int?
  createdAt  DateTime      @default(now())

  session    ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// --------------------------------------------------------
// AUTOMATION & AUDIT
// --------------------------------------------------------

model AutomationWorkflow {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  name          String         @db.VarChar(120)
  status        WorkflowStatus @default(ACTIVE)
  triggerType   String         @db.VarChar(100)
  triggerConfig Json
  actionSteps   Json
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("automation_workflows")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(50)
  entityId   String   @db.VarChar(100)
  details    Json
  ipAddress  String?  @db.VarChar(45)
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
