# ==========================================
# AI WORK OS — Environment Configuration
# ==========================================

# Environment Mode
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL 16 with pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_work_os?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_work_os
POSTGRES_PORT=5432

# Redis 7 Cache & Bus
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_URL="redis://:redispassword@localhost:6379"

# Authentication & Secrets
JWT_ACCESS_SECRET=super_secret_jwt_access_key_at_least_32_characters_long_for_security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_at_least_32_characters_long_for_security
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_secret_key_at_least_32_chars

# AI Models (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
